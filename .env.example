# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=
# Random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token on every webhook call
TELEGRAM_WEBHOOK_SECRET=
# Numeric Telegram user id of the owner
TELEGRAM_OWNER_ID=
# Short name of the Mini App created in BotFather (/newapp)
TELEGRAM_MINIAPP_SHORT_NAME=settings
# Anthropic API key
ANTHROPIC_API_KEY=
# Neon Postgres connection string
DATABASE_URL=
# Secret for signing Mini App session tokens (at least 32 characters)
JWT_SECRET=
# Optional: bakery MCP server base URL
BAKERY_URL=
# Optional: bakery MCP bearer key (bmcp_...), created in the bakery app
BAKERY_MCP_KEY=
# Set by Railway: public domain of the service (do not set by hand)
RAILWAY_PUBLIC_DOMAIN=
# Set by Railway on GitHub deploys: commit sha and message (do not set by hand)
RAILWAY_GIT_COMMIT_SHA=
RAILWAY_GIT_COMMIT_MESSAGE=
